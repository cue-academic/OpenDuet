# DNS hostname only, no scheme or path. Caddy obtains and renews HTTPS certificates.
CUE_DOMAIN=
# Optional: built locally when absent. For releases, use an immutable image tag/digest.
CUE_APP_IMAGE=cue-pilot:local

# Required. Run ./generate-secrets.sh and paste its output here.
# POSTGRES_PASSWORD must be URL-safe (the generator uses hexadecimal).
POSTGRES_PASSWORD=
KEY_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
WORKER_SHARED_SECRET=

# Required Google sign-in. Register https://<CUE_DOMAIN>/api/auth/callback/google.
# Restrict the OAuth application to the school's Workspace organization where possible.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated admin addresses and exact school email domains (no wildcards).
INITIAL_ADMIN_EMAILS=
SIGNIN_ALLOWED_EMAIL_DOMAINS=

# Required managed CopilotKit Intelligence project. Keep the project key server-side.
# The current CLI calls its generated key CPK_INTELLIGENCE_API_KEY; copy its value here.
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
INTELLIGENCE_API_KEY=
# Optional legacy self-hosted license token; leave empty for managed Intelligence.
COPILOTKIT_LICENSE_TOKEN=

# Required for live AI. Alternatively export OPENAI_API_KEY before every Compose invocation.
# Never commit .env or rendered Compose output; both contain secrets.
OPENAI_API_KEY=
# Optional model overrides: select models your OpenAI project can actually call.
ACADEMIC_OS_MODEL=gpt-5.6-terra
ACADEMIC_OS_GUIDE_MODEL=gpt-5.5
ACADEMIC_OS_FAST_MODEL=gpt-4o-mini
# Optional, but keep stable after launch; distinguishes threads in a shared project.
DEPLOYMENT_ID=cue-pilot

# Fixed by compose.yaml, not configurable through this file:
# NODE_ENV=production; OPENBOT_HOST=0.0.0.0; PORT=SERVER_PORT=3001
# OPENBOT_SINGLE_USER=false; ACADEMIC_OS_PRIVATE_DEMO=0
# EMBEDDED_POSTGRES=off; EMBEDDED_COMPUTER=off
# AGENT_COMPUTER_URL=COMPUTER_SUPERVISOR_URL=COMPUTER_SANDBOX_NAMESPACE=""
# DATABASE_URL is constructed from POSTGRES_PASSWORD and the private postgres service.
# Public/auth/app URLs and TRUSTED_ORIGINS are https://<CUE_DOMAIN>.
# SERVER_INTERNAL_URL=http://app:3001; TENANT_PACKAGE_DIR=../examples/openduet
# DO_NOT_TRACK=1. Unlisted upstream optional integrations are deliberately not passed through.
